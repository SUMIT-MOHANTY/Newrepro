# Use correct Node version
FROM node:20-alpine

WORKDIR /app

# Copy only package files first
COPY package*.json ./

# Clean install (important fix)
RUN rm -rf node_modules package-lock.json \
    && npm cache clean --force \
    && npm install

# Copy rest of code
COPY . .

# Build app
RUN npm run build

# Install PM2
RUN npm install -g pm2

EXPOSE 5174

CMD ["pm2-runtime", "ecosystem.config.cjs"]
