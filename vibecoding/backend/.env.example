# ═══════════════════════════════════════════════════════════════════════════
# AI Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Simple provider toggle:
# false -> use AI_BASE_URL (NVIDIA/OpenAI-compatible)
# true  -> use BRN_LLAMA_URL
USE_BRN_LLAMA=false

# ───────────────────────────────────────────────────────────────────────────
# OpenAI-Compatible Provider Settings (used when USE_BRN_LLAMA=false)
# ───────────────────────────────────────────────────────────────────────────
AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=your_nvidia_api_key_here
AI_MODEL=openai/gpt-oss-120b

# Optional AI Configuration Variables (with defaults)
AI_MAX_TOKENS=4096
AI_TEMPERATURE=1.0
AI_TOP_P=1.0
AI_FREQUENCY_PENALTY=0.0
AI_PRESENCE_PENALTY=0.0
AI_STREAM=false

# ───────────────────────────────────────────────────────────────────────────
# BRN Llama Provider Settings (used when USE_BRN_LLAMA=true)
# ───────────────────────────────────────────────────────────────────────────
BRN_LLAMA_URL=https://brn-llama.bourntec.com/api/process
BRN_AGENT_ID=erhjgo5go49uoi3uyrp938ry
BRN_MODEL=BournAI
BRN_PLATFORM_ID=DSuite
BRN_MAX_TOKENS=50000
BRN_TEMPERATURE=0.7

# Public host URL for preview containers (use your AWS domain)
# Example: https://your-app.com or http://your-ec2-ip.compute.amazonaws.com
PUBLIC_HOST=http://localhost

USE_PREVIEW_PROXY=true
