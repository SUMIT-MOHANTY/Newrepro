FROM node:18-slim

WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Install common Node.js packages
RUN npm install -g express react react-dom next

# Copy package.json if exists
COPY package*.json ./
RUN npm install 2>/dev/null || echo "No package.json found"

EXPOSE 3000 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -s http://localhost:3000/ > /dev/null || curl -s http://localhost:8080/ > /dev/null || exit 1

# Auto-detect and run
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🚀 Node.js Auto-Runner Starting..."\n\
\n\
if [ -f "/app/package.json" ]; then\n\
    npm install\n\
    if grep -q "\"dev\":" package.json; then\n\
        npm run dev\n\
    elif grep -q "\"start\":" package.json; then\n\
        npm start\n\
    fi\n\
elif [ -f "/app/server.js" ]; then\n\
    node server.js\n\
elif [ -f "/app/index.js" ]; then\n\
    node index.js\n\
elif [ -f "/app/app.js" ]; then\n\
    node app.js\n\
else\n\
    NODE_FILE=$(ls /app/*.js 2>/dev/null | head -n 1)\n\
    if [ -n "$NODE_FILE" ]; then\n\
        node $NODE_FILE\n\
    else\n\
        echo "❌ No JavaScript file found"\n\
        exit 1\n\
    fi\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
