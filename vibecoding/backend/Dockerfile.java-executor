FROM openjdk:17-slim

WORKDIR /app

# Install curl and Maven
RUN apt-get update && apt-get install -y curl maven && rm -rf /var/lib/apt/lists/*

EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -s http://localhost:8080/ > /dev/null || exit 1

# Auto-compile and run
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🚀 Java Auto-Runner Starting..."\n\
\n\
if [ -f "/app/pom.xml" ]; then\n\
    mvn spring-boot:run\n\
else\n\
    JAVA_FILE=$(find /app -name "*.java" | head -n 1)\n\
    if [ -n "$JAVA_FILE" ]; then\n\
        javac $JAVA_FILE\n\
        CLASS_NAME=$(basename $JAVA_FILE .java)\n\
        java $CLASS_NAME\n\
    else\n\
        echo "❌ No Java file found"\n\
        exit 1\n\
    fi\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
