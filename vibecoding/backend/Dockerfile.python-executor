FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install common Python web frameworks and tools
RUN pip install --no-cache-dir \
    flask \
    django \
    fastapi \
    uvicorn \
    requests \
    beautifulsoup4 \
    sqlalchemy \
    pandas \
    numpy \
    streamlit \
    jupyter \
    plotly \
    dash \
    bottle \
    tornado \
    sanic \
    quart \
    aiohttp

# Copy requirements if they exist
COPY requirements.txt* ./
RUN pip install --no-cache-dir -r requirements.txt 2>/dev/null || echo "No requirements.txt found"

# Expose common ports
EXPOSE 5000 8000 3000 8080 8501

# Health check that accepts any HTTP response (even 500 errors mean the server is running)
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -s http://localhost:5000/ > /dev/null || curl -s http://localhost:8000/ > /dev/null || curl -s http://localhost:3000/ > /dev/null || exit 1

# Create entrypoint script that auto-detects and runs the app
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "🚀 VibeCoding Auto-Runner Starting..."\n\
\n\
# Find Python file (app.py, index.py, main.py, or any .py)\n\
PYTHON_FILE=""\n\
if [ -f "/app/app.py" ]; then\n\
    PYTHON_FILE="app.py"\n\
elif [ -f "/app/index.py" ]; then\n\
    PYTHON_FILE="index.py"\n\
elif [ -f "/app/main.py" ]; then\n\
    PYTHON_FILE="main.py"\n\
else\n\
    PYTHON_FILE=$(ls /app/*.py 2>/dev/null | head -n 1 | xargs basename)\n\
fi\n\
\n\
if [ -z "$PYTHON_FILE" ]; then\n\
    echo "❌ Error: No Python file found in /app"\n\
    ls -la /app\n\
    exit 1\n\
fi\n\
\n\
echo "📝 Found: $PYTHON_FILE"\n\
\n\
# Detect framework and run\n\
if grep -qi "from django\\|import django" /app/$PYTHON_FILE; then\n\
    echo "✅ Django detected - running instantly"\n\
    python $PYTHON_FILE\n\
elif grep -qi "from flask\\|Flask(" /app/$PYTHON_FILE; then\n\
    echo "✅ Flask detected - running with host binding"\n\
    export FLASK_RUN_HOST=0.0.0.0\n\
    export FLASK_RUN_PORT=${PORT:-5000}\n\
    if grep -qi "app\\.run(" /app/$PYTHON_FILE; then\n\
        python $PYTHON_FILE\n\
    else\n\
        export FLASK_APP=$PYTHON_FILE\n\
        flask run --host=0.0.0.0 --port=${PORT:-5000}\n\
    fi\n\
elif grep -qi "from fastapi\\|FastAPI(" /app/$PYTHON_FILE; then\n\
    echo "✅ FastAPI detected - running instantly"\n\
    python $PYTHON_FILE\n\
else\n\
    echo "✅ Running Python app"\n\
    python $PYTHON_FILE\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
