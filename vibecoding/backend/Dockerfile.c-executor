FROM gcc:latest

WORKDIR /app

# Install curl
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -s http://localhost:8080/ > /dev/null || exit 1

# Auto-compile and run C
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🚀 C Auto-Runner Starting..."\n\
\n\
C_FILE=$(find /app -name "*.c" | head -n 1)\n\
if [ -n "$C_FILE" ]; then\n\
    gcc -o /app/program $C_FILE\n\
    /app/program\n\
else\n\
    echo "❌ No C file found"\n\
    exit 1\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
