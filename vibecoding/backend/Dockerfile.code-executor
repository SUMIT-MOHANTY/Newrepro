FROM nginx:alpine

# Create the /app directory
RUN mkdir -p /app

# The official NGINX image processes templates in /etc/nginx/templates/*.template
# and outputs them to /etc/nginx/conf.d/*.conf using envsubst
COPY default.conf.template /etc/nginx/templates/default.conf.template

# Default values if not provided
ENV NGINX_PORT=80
ENV NGINX_ROOT=/app

# Remove default welcome files
RUN rm -rf /usr/share/nginx/html/*

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
