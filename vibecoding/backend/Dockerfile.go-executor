FROM golang:1.21-alpine

WORKDIR /app

# Install curl
RUN apk add --no-cache curl

EXPOSE 8080

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -s http://localhost:8080/ > /dev/null || exit 1

# Auto-run Go
RUN echo '#!/bin/sh\n\
set -e\n\
echo "🚀 Go Auto-Runner Starting..."\n\
\n\
if [ -f "/app/go.mod" ]; then\n\
    go mod download\n\
fi\n\
\n\
if [ -f "/app/main.go" ]; then\n\
    go run main.go\n\
else\n\
    GO_FILE=$(ls /app/*.go 2>/dev/null | head -n 1)\n\
    if [ -n "$GO_FILE" ]; then\n\
        go run $GO_FILE\n\
    else\n\
        echo "❌ No Go file found"\n\
        exit 1\n\
    fi\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
