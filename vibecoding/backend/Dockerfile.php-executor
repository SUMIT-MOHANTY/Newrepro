FROM php:8.2-cli

WORKDIR /app

# Install curl
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

EXPOSE 8000

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -s http://localhost:8000/ > /dev/null || exit 1

# Auto-run PHP
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🚀 PHP Auto-Runner Starting..."\n\
\n\
if [ -f "/app/index.php" ]; then\n\
    php -S 0.0.0.0:8000 -t /app\n\
else\n\
    PHP_FILE=$(ls /app/*.php 2>/dev/null | head -n 1)\n\
    if [ -n "$PHP_FILE" ]; then\n\
        php -S 0.0.0.0:8000 -t /app\n\
    else\n\
        echo "❌ No PHP file found"\n\
        exit 1\n\
    fi\n\
fi\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
